[Unit]
Description=Publish all captured filtered %i texts privately to Google Drive

[Service]
Type=oneshot
UMask=0077
ExecStart=%h/.local/lib/minbox-text-archive/.venv/bin/python %h/.local/lib/minbox-text-archive/owner_publish_cli.py --config %h/.config/minbox-text-archive/publishers/%i-full.json
TimeoutStartSec=600
NoNewPrivileges=true
