-	if count != 500 || (folder != gmproto.ListConversationsRequest_SPAM_BLOCKED && folder != gmproto.ListConversationsRequest_INBOX && folder != gmproto.ListConversationsRequest_ARCHIVE) {
+	f.lastCount.Store(int32(count))
+	if count < 500 || count > phoneSpamMaxLimit || (folder != gmproto.ListConversationsRequest_SPAM_BLOCKED && folder != gmproto.ListConversationsRequest_INBOX && folder != gmproto.ListConversationsRequest_ARCHIVE) {
 		f.wrongFolder.Store(true)
 	}
 	if f.release != nil {
@@ -357,3 +359,37 @@ func TestPhoneFolderScannerConnectionAndFatalEventsGateRequests(t *testing.T) {
 		t.Fatal("fatal relay error did not cancel metadata")
 	}
 }
+
+func TestPhoneSpamCappedFolderEscalatesRequestSize(t *testing.T) {
+	ctx := context.Background()
+	st, err := store.Open(ctx, filepath.Join(t.TempDir(), "archive.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer st.Close()
+	// A folder larger than the default request: the phone returns exactly the
+	// requested count, so the scanner must ask for more on the next cycle.
+	fixture := &spamListFixture{response: &gmproto.ListConversationsResponse{Conversations: make([]*gmproto.Conversation, 500)}}
+	scanner := &phoneSpamScanner{client: fixture, store: st, logger: zerolog.Nop()}
+	scanner.scan(ctx)
+	if got := fixture.lastCount.Load(); got != 500 {
+		t.Fatalf("first request size = %d, want 500", got)
+	}
+	var next int
+	if err := st.DB().QueryRowContext(ctx, "SELECT next_limit FROM phone_spam_scan_state").Scan(&next); err != nil || next != 1000 {
+		t.Fatalf("next_limit = %d err=%v, want 1000", next, err)
+	}
+	scanner.scan(ctx)
+	if got := fixture.lastCount.Load(); got != 1000 {
+		t.Fatalf("second request size = %d, want 1000", got)
+	}
+	if fixture.wrongFolder.Load() {
+		t.Fatal("request size or folder out of bounds")
+	}
+	// Escalation is bounded.
+	scanner.limit = phoneSpamMaxLimit
+	scanner.scan(ctx)
+	if got := fixture.lastCount.Load(); int(got) != phoneSpamMaxLimit {
+		t.Fatalf("bounded request size = %d, want %d", got, phoneSpamMaxLimit)
+	}
+}
