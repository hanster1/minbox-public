diff --git a/internal/store/presence.go b/internal/store/presence.go
new file mode 100644
index 0000000..59fd1b1
--- /dev/null
+++ b/internal/store/presence.go
@@ -0,0 +1,106 @@
+package store
+
+import (
+	"context"
+	"errors"
+	"fmt"
+)
+
+// ErrImplausibleDeletion is returned when a scan would mark too many messages
+// missing at once. That pattern means a partial or broken phone response, not
+// real deletions, so nothing is recorded.
+var ErrImplausibleDeletion = errors.New("implausible number of missing messages; scan ignored")
+
+// DeletionConfirmScans is how many consecutive complete scans must miss a
+// message before it is flagged deleted.
+const DeletionConfirmScans = 2
+
+// PresenceScan is one complete read of a conversation's messages from the
+// phone, covering [WindowStart, WindowEnd] (message timestamps, ms).
+type PresenceScan struct {
+	ConversationID string
+	WindowStart    int64
+	WindowEnd      int64
+	Seen           map[string]bool
+	StartedAt      int64 // scan start, ms; messages newer than StartedAt-60s are never judged
+}
+
+// PresenceResult reports what one scan changed.
+type PresenceResult struct {
+	Judged  int
+	Missing int
+	Flagged int
+	Cleared int
+}
+
+// ApplyPresenceScan records which stored messages the phone still has.
+// It never deletes message rows. Guards: an empty scan changes nothing; a scan
+// missing more than max(5, 20%) of judged messages changes nothing.
+func (s *Store) ApplyPresenceScan(ctx context.Context, scan PresenceScan) (PresenceResult, error) {
+	var res PresenceResult
+	if len(scan.Seen) == 0 || scan.ConversationID == "" || scan.WindowStart <= 0 || scan.WindowEnd < scan.WindowStart {
+		return res, nil
+	}
+	cutoff := scan.StartedAt - 60_000
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return res, err
+	}
+	defer tx.Rollback()
+	rows, err := tx.QueryContext(ctx, `SELECT message_id FROM messages WHERE conversation_id=? AND timestamp_ms>=? AND timestamp_ms<=? AND timestamp_ms<=?`,
+		scan.ConversationID, scan.WindowStart, scan.WindowEnd, cutoff)
+	if err != nil {
+		return res, err
+	}
+	var present, missing []string
+	for rows.Next() {
+		var id string
+		if err := rows.Scan(&id); err != nil {
+			rows.Close()
+			return res, err
+		}
+		if scan.Seen[id] {
+			present = append(present, id)
+		} else {
+			missing = append(missing, id)
+		}
+	}
+	if err := rows.Close(); err != nil {
+		return res, err
+	}
+	res.Judged = len(present) + len(missing)
+	res.Missing = len(missing)
+	limit := res.Judged / 5
+	if limit < 5 {
+		limit = 5
+	}
+	if len(missing) > limit {
+		return res, fmt.Errorf("%w (%d of %d)", ErrImplausibleDeletion, len(missing), res.Judged)
+	}
+	for _, id := range present {
+		var deleted int64
+		err := tx.QueryRowContext(ctx, `SELECT deleted_at FROM message_presence WHERE message_id=?`, id).Scan(&deleted)
+		if err == nil && deleted > 0 {
+			res.Cleared++
+		}
+		if _, err := tx.ExecContext(ctx, `INSERT INTO message_presence(message_id,conversation_id,last_seen_at) VALUES(?,?,?)
+			ON CONFLICT(message_id) DO UPDATE SET missing_scans=0,deleted_at=0,last_seen_at=excluded.last_seen_at`, id, scan.ConversationID, scan.StartedAt); err != nil {
+			return res, err
+		}
+	}
+	for _, id := range missing {
+		if _, err := tx.ExecContext(ctx, `INSERT INTO message_presence(message_id,conversation_id,missing_scans,last_missing_at) VALUES(?,?,1,?)
+			ON CONFLICT(message_id) DO UPDATE SET missing_scans=CASE WHEN last_missing_at<excluded.last_missing_at THEN missing_scans+1 ELSE missing_scans END,
+			last_missing_at=MAX(last_missing_at,excluded.last_missing_at)`, id, scan.ConversationID, scan.StartedAt); err != nil {
+			return res, err
+		}
+		r, err := tx.ExecContext(ctx, `UPDATE message_presence SET deleted_at=? WHERE message_id=? AND deleted_at=0 AND missing_scans>=?`, scan.StartedAt, id, DeletionConfirmScans)
+		if err != nil {
+			return res, err
+		}
+		if n, _ := r.RowsAffected(); n > 0 {
+			res.Flagged++
+		}
+	}
+	return res, tx.Commit()
+}
diff --git a/internal/store/presence_test.go b/internal/store/presence_test.go
new file mode 100644
index 0000000..8c697d8
--- /dev/null
+++ b/internal/store/presence_test.go
@@ -0,0 +1,144 @@
+package store
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"path/filepath"
+	"testing"
+)
+
+func presenceStore(t *testing.T, n int) *Store {
+	t.Helper()
+	ctx := context.Background()
+	st, err := Open(ctx, filepath.Join(t.TempDir(), "p.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { st.Close() })
+	if err := st.UpsertConversation(ctx, Conversation{ID: "c1", SourcePlatform: "gm"}); err != nil {
+		t.Fatal(err)
+	}
+	for i := 1; i <= n; i++ {
+		if err := st.UpsertMessage(ctx, Message{ID: fmt.Sprintf("m%02d", i), ConversationID: "c1", SourcePlatform: "gm", TimestampMS: int64(i * 1000)}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return st
+}
+
+func seenExcept(n int, skip ...string) map[string]bool {
+	m := map[string]bool{}
+	for i := 1; i <= n; i++ {
+		m[fmt.Sprintf("m%02d", i)] = true
+	}
+	for _, s := range skip {
+		delete(m, s)
+	}
+	return m
+}
+
+func deletedAt(t *testing.T, st *Store, id string) int64 {
+	var v int64
+	err := st.DB().QueryRow(`SELECT deleted_at FROM message_presence WHERE message_id=?`, id).Scan(&v)
+	if err != nil {
+		return -1
+	}
+	return v
+}
+
+func TestPresenceRequiresTwoConsecutiveMisses(t *testing.T) {
+	ctx := context.Background()
+	st := presenceStore(t, 20)
+	scan := func(at int64, skip ...string) PresenceResult {
+		r, err := st.ApplyPresenceScan(ctx, PresenceScan{ConversationID: "c1", WindowStart: 1000, WindowEnd: 20000, Seen: seenExcept(20, skip...), StartedAt: at})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return r
+	}
+	if r := scan(1_000_000, "m05"); r.Flagged != 0 || deletedAt(t, st, "m05") != 0 {
+		t.Fatalf("flagged after one miss: %+v", r)
+	}
+	if r := scan(1_000_000, "m05"); r.Flagged != 0 {
+		t.Fatalf("same scan replayed counted twice: %+v", r)
+	}
+	if r := scan(2_000_000, "m05"); r.Flagged != 1 || deletedAt(t, st, "m05") != 2_000_000 {
+		t.Fatalf("not flagged after two misses: %+v", r)
+	}
+	var rows int
+	st.DB().QueryRow(`SELECT COUNT(*) FROM messages WHERE message_id='m05'`).Scan(&rows)
+	if rows != 1 {
+		t.Fatal("message row removed")
+	}
+	if r := scan(3_000_000); r.Cleared != 1 || deletedAt(t, st, "m05") != 0 {
+		t.Fatalf("reappearing message not cleared: %+v", r)
+	}
+}
+
+func TestPresenceMissResetBySightingIsNotConsecutive(t *testing.T) {
+	ctx := context.Background()
+	st := presenceStore(t, 20)
+	for i, skip := range [][]string{{"m03"}, {}, {"m03"}} {
+		if _, err := st.ApplyPresenceScan(ctx, PresenceScan{ConversationID: "c1", WindowStart: 1000, WindowEnd: 20000, Seen: seenExcept(20, skip...), StartedAt: int64(i+1) * 1_000_000}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if deletedAt(t, st, "m03") != 0 {
+		t.Fatal("non-consecutive misses flagged")
+	}
+}
+
+func TestPresenceEmptyAndImplausibleScansChangeNothing(t *testing.T) {
+	ctx := context.Background()
+	st := presenceStore(t, 30)
+	for i := 0; i < 3; i++ {
+		r, err := st.ApplyPresenceScan(ctx, PresenceScan{ConversationID: "c1", WindowStart: 1000, WindowEnd: 30000, Seen: map[string]bool{}, StartedAt: int64(i+1) * 1_000_000})
+		if err != nil || r.Judged != 0 {
+			t.Fatalf("empty scan judged: %+v %v", r, err)
+		}
+		_, err = st.ApplyPresenceScan(ctx, PresenceScan{ConversationID: "c1", WindowStart: 1000, WindowEnd: 30000, Seen: map[string]bool{"m01": true}, StartedAt: int64(i+1) * 1_000_000})
+		if !errors.Is(err, ErrImplausibleDeletion) {
+			t.Fatalf("expected implausible, got %v", err)
+		}
+	}
+	var n int
+	st.DB().QueryRow(`SELECT COUNT(*) FROM message_presence`).Scan(&n)
+	if n != 0 {
+		t.Fatalf("guarded scans wrote %d rows", n)
+	}
+}
+
+func TestPresenceOnlyJudgesWindowAndOldEnoughMessages(t *testing.T) {
+	ctx := context.Background()
+	st := presenceStore(t, 20)
+	// Window covers m11..m20 only; m01..m10 are older than the phone returned.
+	seen := map[string]bool{}
+	for i := 11; i <= 20; i++ {
+		seen[fmt.Sprintf("m%02d", i)] = true
+	}
+	for _, at := range []int64{1_000_000, 2_000_000} {
+		r, err := st.ApplyPresenceScan(ctx, PresenceScan{ConversationID: "c1", WindowStart: 11000, WindowEnd: 20000, Seen: seen, StartedAt: at})
+		if err != nil || r.Missing != 0 || r.Judged != 10 {
+			t.Fatalf("judged outside window: %+v %v", r, err)
+		}
+	}
+	// Messages newer than StartedAt-60s are not judged.
+	r, err := st.ApplyPresenceScan(ctx, PresenceScan{ConversationID: "c1", WindowStart: 1000, WindowEnd: 20000, Seen: seenExcept(20, "m20"), StartedAt: 20000 + 30_000})
+	if err != nil || r.Missing != 0 {
+		t.Fatalf("judged too-new message: %+v %v", r, err)
+	}
+}
+
+func TestPresenceMigrationKeepsExistingRows(t *testing.T) {
+	st := presenceStore(t, 3)
+	v, err := st.SchemaVersion(context.Background())
+	if err != nil || v != 7 {
+		t.Fatalf("schema version %d %v", v, err)
+	}
+	var n int
+	st.DB().QueryRow(`SELECT COUNT(*) FROM messages`).Scan(&n)
+	if n != 3 {
+		t.Fatal("rows lost")
+	}
+}
