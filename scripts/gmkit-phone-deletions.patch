diff --git a/internal/cmd/deletion_scan.go b/internal/cmd/deletion_scan.go
new file mode 100644
index 0000000..0de989a
--- /dev/null
+++ b/internal/cmd/deletion_scan.go
@@ -0,0 +1,223 @@
+package cmd
+
+import (
+	"context"
+	"errors"
+	"time"
+
+	"github.com/johnlindquist/gmkit/internal/store"
+	gmsync "github.com/johnlindquist/gmkit/internal/sync"
+	"github.com/rs/zerolog"
+	"go.mau.fi/mautrix-gmessages/pkg/libgm/gmproto"
+)
+
+const (
+	deletionScanInterval        = 30 * time.Minute
+	deletionConvsPerCycle       = 5
+	deletionMaxPages            = 40
+	deletionPageSize      int64 = 50
+	deletionCallTimeout         = 30 * time.Second
+)
+
+type messageFetcher interface {
+	FetchMessages(conversationID string, count int64, cursor *gmproto.Cursor) (*gmproto.ListMessagesResponse, error)
+}
+
+// deletionScanner rotates through conversations, reading each one's messages
+// from the phone newest-first and recording which stored messages are still
+// there. It never removes rows; store.ApplyPresenceScan owns all guards.
+type deletionScanner struct {
+	client   messageFetcher
+	store    *store.Store
+	logger   zerolog.Logger
+	interval time.Duration
+	perCycle int
+	maxPages int
+	canScan  func() bool
+	now      func() time.Time
+}
+
+type deletionCycle struct {
+	checked, skipped, flagged, cleared int
+	last                               string
+	failure                            string
+}
+
+func (s *deletionScanner) clock() time.Time {
+	if s.now != nil {
+		return s.now()
+	}
+	return time.Now()
+}
+
+func (s *deletionScanner) fetch(ctx context.Context, conv string, cursor *gmproto.Cursor) (*gmproto.ListMessagesResponse, error) {
+	type result struct {
+		r   *gmproto.ListMessagesResponse
+		err error
+	}
+	ch := make(chan result, 1)
+	go func() {
+		r, err := s.client.FetchMessages(conv, deletionPageSize, cursor)
+		ch <- result{r, err}
+	}()
+	t := time.NewTimer(deletionCallTimeout)
+	defer t.Stop()
+	select {
+	case r := <-ch:
+		return r.r, r.err
+	case <-t.C:
+		return nil, errors.New("fetch timed out")
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	}
+}
+
+// scanConversation returns the presence observation, or ok=false when the
+// phone's answer is unusable (error, empty, wrong conversation only).
+func (s *deletionScanner) scanConversation(ctx context.Context, conv string, started int64) (store.PresenceScan, bool) {
+	scan := store.PresenceScan{ConversationID: conv, Seen: map[string]bool{}, StartedAt: started}
+	var cursor *gmproto.Cursor
+	pages := s.maxPages
+	if pages <= 0 {
+		pages = deletionMaxPages
+	}
+	for i := 0; i < pages; i++ {
+		resp, err := s.fetch(ctx, conv, cursor)
+		if err != nil || resp == nil {
+			return scan, false
+		}
+		msgs := resp.GetMessages()
+		for _, m := range msgs {
+			if m == nil || m.GetConversationID() != conv || m.GetMessageID() == "" {
+				continue
+			}
+			ts := gmsync.NormalizeTimestampMS(m.GetTimestamp())
+			scan.Seen[m.GetMessageID()] = true
+			if scan.WindowStart == 0 || ts < scan.WindowStart {
+				scan.WindowStart = ts
+			}
+			if ts > scan.WindowEnd {
+				scan.WindowEnd = ts
+			}
+		}
+		next := resp.GetCursor()
+		if len(msgs) == 0 || next == nil || sameCursorPtr(cursor, next) {
+			break
+		}
+		cursor = next
+	}
+	// Partial reads are fine: newest-first paging covers [WindowStart, WindowEnd]
+	// contiguously, and only stored messages inside that window are judged.
+	return scan, len(scan.Seen) > 0
+}
+
+func sameCursorPtr(a, b *gmproto.Cursor) bool {
+	if a == nil || b == nil {
+		return a == b
+	}
+	return a.GetLastItemID() == b.GetLastItemID() && a.GetLastItemTimestamp() == b.GetLastItemTimestamp()
+}
+
+func (s *deletionScanner) nextConversations(ctx context.Context, after string, n int) ([]string, error) {
+	rows, err := s.store.DB().QueryContext(ctx, `SELECT conversation_id FROM conversations WHERE conversation_id>? ORDER BY conversation_id LIMIT ?`, after, n)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	var ids []string
+	for rows.Next() {
+		var id string
+		if err := rows.Scan(&id); err != nil {
+			return nil, err
+		}
+		ids = append(ids, id)
+	}
+	return ids, rows.Err()
+}
+
+func (s *deletionScanner) scan(ctx context.Context) deletionCycle {
+	var c deletionCycle
+	if err := s.store.DB().QueryRowContext(ctx, `SELECT last_conversation_id FROM deletion_scan_state WHERE id=1`).Scan(&c.last); err != nil {
+		c.failure = "state read failed"
+		s.record(ctx, c)
+		return c
+	}
+	n := s.perCycle
+	if n <= 0 {
+		n = deletionConvsPerCycle
+	}
+	ids, err := s.nextConversations(ctx, c.last, n)
+	if err == nil && len(ids) == 0 && c.last != "" {
+		ids, err = s.nextConversations(ctx, "", n)
+	}
+	if err != nil {
+		c.failure = "conversation list failed"
+		s.record(ctx, c)
+		return c
+	}
+	for _, id := range ids {
+		if ctx.Err() != nil {
+			break
+		}
+		c.last = id
+		started := s.clock().UnixMilli()
+		obs, ok := s.scanConversation(ctx, id, started)
+		if !ok {
+			c.skipped++
+			continue
+		}
+		res, err := s.store.ApplyPresenceScan(ctx, obs)
+		if err != nil {
+			c.skipped++
+			if errors.Is(err, store.ErrImplausibleDeletion) {
+				s.logger.Warn().Str("conversation", id).Err(err).Msg("Deletion scan ignored")
+			} else {
+				c.failure = "presence persistence failed"
+			}
+			continue
+		}
+		c.checked++
+		c.flagged += res.Flagged
+		c.cleared += res.Cleared
+	}
+	s.record(ctx, c)
+	return c
+}
+
+func (s *deletionScanner) record(ctx context.Context, c deletionCycle) {
+	now := s.clock().UnixMilli()
+	success := int64(0)
+	if c.failure == "" {
+		success = now
+	}
+	if _, err := s.store.DB().ExecContext(ctx, `UPDATE deletion_scan_state SET attempted_at=?,succeeded_at=CASE WHEN ?>0 THEN ? ELSE succeeded_at END,
+		last_conversation_id=?,checked_conversations=?,skipped_conversations=?,flagged=?,cleared=?,error=? WHERE id=1`,
+		now, success, success, c.last, c.checked, c.skipped, c.flagged, c.cleared, c.failure); err != nil {
+		s.logger.Warn().Err(err).Msg("Deletion scan state persistence failed")
+	}
+}
+
+func (s *deletionScanner) run(ctx context.Context) func() {
+	scanCtx, cancel := context.WithCancel(ctx)
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		interval := s.interval
+		if interval <= 0 {
+			interval = deletionScanInterval
+		}
+		ticker := time.NewTicker(interval)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-scanCtx.Done():
+				return
+			case <-ticker.C:
+				if s.canScan == nil || s.canScan() {
+					s.scan(scanCtx)
+				}
+			}
+		}
+	}()
+	return func() { cancel(); <-done }
+}
diff --git a/internal/cmd/deletion_scan_test.go b/internal/cmd/deletion_scan_test.go
new file mode 100644
index 0000000..1a19a30
--- /dev/null
+++ b/internal/cmd/deletion_scan_test.go
@@ -0,0 +1,165 @@
+package cmd
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/johnlindquist/gmkit/internal/store"
+	"github.com/rs/zerolog"
+	"go.mau.fi/mautrix-gmessages/pkg/libgm/gmproto"
+)
+
+type phoneMessagesFixture struct {
+	byConv map[string][]string // newest first
+	err    error
+	page   int
+}
+
+func (f *phoneMessagesFixture) FetchMessages(conv string, count int64, cursor *gmproto.Cursor) (*gmproto.ListMessagesResponse, error) {
+	if f.err != nil {
+		return nil, f.err
+	}
+	ids := f.byConv[conv]
+	start := 0
+	if cursor != nil {
+		fmt.Sscanf(cursor.GetLastItemID(), "%d", &start)
+	}
+	size := f.page
+	if size <= 0 {
+		size = int(count)
+	}
+	end := start + size
+	if end > len(ids) {
+		end = len(ids)
+	}
+	resp := &gmproto.ListMessagesResponse{}
+	for _, id := range ids[start:end] {
+		var n int
+		fmt.Sscanf(id, "m%d", &n)
+		resp.Messages = append(resp.Messages, &gmproto.Message{MessageID: id, ConversationID: conv, Timestamp: int64(n) * 1000})
+	}
+	if end < len(ids) {
+		resp.Cursor = &gmproto.Cursor{LastItemID: fmt.Sprint(end), LastItemTimestamp: int64(end)}
+	}
+	return resp, nil
+}
+
+func deletionFixtureStore(t *testing.T, n int) *store.Store {
+	ctx := context.Background()
+	st, err := store.Open(ctx, filepath.Join(t.TempDir(), "d.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { st.Close() })
+	st.UpsertConversation(ctx, store.Conversation{ID: "c1", SourcePlatform: "gm"})
+	for i := 1; i <= n; i++ {
+		st.UpsertMessage(ctx, store.Message{ID: fmt.Sprintf("m%02d", i), ConversationID: "c1", SourcePlatform: "gm", TimestampMS: int64(i * 1000)})
+	}
+	return st
+}
+
+func phoneIDs(n int, skip string) []string {
+	var ids []string
+	for i := n; i >= 1; i-- {
+		id := fmt.Sprintf("m%02d", i)
+		if id != skip {
+			ids = append(ids, id)
+		}
+	}
+	return ids
+}
+
+func flaggedCount(st *store.Store) int {
+	var n int
+	st.DB().QueryRow(`SELECT COUNT(*) FROM message_presence WHERE deleted_at>0`).Scan(&n)
+	return n
+}
+
+func TestDeletionScannerFlagsAfterTwoCyclesAcrossPages(t *testing.T) {
+	st := deletionFixtureStore(t, 30)
+	phone := &phoneMessagesFixture{byConv: map[string][]string{"c1": phoneIDs(30, "m07")}, page: 7}
+	clock := int64(10_000_000)
+	s := &deletionScanner{client: phone, store: st, logger: zerolog.Nop(), now: func() time.Time { clock += 1_000_000; return time.UnixMilli(clock) }}
+	if c := s.scan(context.Background()); c.checked != 1 || c.flagged != 0 {
+		t.Fatalf("cycle 1: %+v", c)
+	}
+	if c := s.scan(context.Background()); c.flagged != 1 || flaggedCount(st) != 1 {
+		t.Fatalf("cycle 2: %+v", c)
+	}
+	phone.byConv["c1"] = phoneIDs(30, "")
+	if c := s.scan(context.Background()); c.cleared != 1 || flaggedCount(st) != 0 {
+		t.Fatalf("restore: %+v", c)
+	}
+}
+
+func TestDeletionScannerSkipsErrorsEmptyAndWrongConversation(t *testing.T) {
+	ctx := context.Background()
+	for name, phone := range map[string]*phoneMessagesFixture{
+		"error": {err: errors.New("offline")},
+		"empty": {byConv: map[string][]string{}},
+		"wrong": {byConv: map[string][]string{"c1": nil, "other": phoneIDs(30, "")}},
+	} {
+		t.Run(name, func(t *testing.T) {
+			st := deletionFixtureStore(t, 30)
+			clock := int64(10_000_000)
+			s := &deletionScanner{client: phone, store: st, logger: zerolog.Nop(), now: func() time.Time { clock += 1_000_000; return time.UnixMilli(clock) }}
+			for i := 0; i < 3; i++ {
+				if c := s.scan(ctx); c.skipped != 1 || c.flagged != 0 {
+					t.Fatalf("%+v", c)
+				}
+			}
+			var n int
+			st.DB().QueryRow(`SELECT COUNT(*) FROM message_presence`).Scan(&n)
+			if n != 0 {
+				t.Fatalf("wrote %d presence rows", n)
+			}
+		})
+	}
+}
+
+func TestDeletionScannerPartialPhoneHistoryDoesNotFlagOlderMessages(t *testing.T) {
+	st := deletionFixtureStore(t, 30)
+	// Phone only returns the newest 10 (e.g. history limit); older stored rows must not be judged.
+	phone := &phoneMessagesFixture{byConv: map[string][]string{"c1": phoneIDs(30, "")[:10]}}
+	clock := int64(10_000_000)
+	s := &deletionScanner{client: phone, store: st, logger: zerolog.Nop(), now: func() time.Time { clock += 1_000_000; return time.UnixMilli(clock) }}
+	for i := 0; i < 3; i++ {
+		s.scan(context.Background())
+	}
+	if flaggedCount(st) != 0 {
+		t.Fatal("older-than-window messages flagged")
+	}
+}
+
+func TestPhoneSpamEscalatesLimitWhileCapped(t *testing.T) {
+	ctx := context.Background()
+	st, err := store.Open(ctx, filepath.Join(t.TempDir(), "s.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer st.Close()
+	fixture := &spamListFixture{response: &gmproto.ListConversationsResponse{Conversations: make([]*gmproto.Conversation, 500)}}
+	s := &phoneSpamScanner{client: fixture, store: st, logger: zerolog.Nop(), timeout: time.Second}
+	s.scan(ctx)
+	if fixture.lastCount.Load() != 500 || s.currentLimit() != 1000 {
+		t.Fatalf("first request %d, next %d", fixture.lastCount.Load(), s.currentLimit())
+	}
+	s.scan(ctx)
+	if fixture.lastCount.Load() != 1000 {
+		t.Fatalf("second request %d", fixture.lastCount.Load())
+	}
+	var next int
+	st.DB().QueryRow(`SELECT next_limit FROM phone_spam_scan_state`).Scan(&next)
+	if next != 1000 { // 500 returned < 1000 requested: snapshot, no further escalation
+		t.Fatalf("next_limit %d", next)
+	}
+	var coverage string
+	st.DB().QueryRow(`SELECT coverage FROM phone_spam_scan_state`).Scan(&coverage)
+	if coverage != "snapshot" {
+		t.Fatalf("coverage %s", coverage)
+	}
+}
