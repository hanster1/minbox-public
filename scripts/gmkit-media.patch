+++ i/internal/sync/media_test.go
@@ -0,0 +1,44 @@
+package sync
+
+import (
+	"context"
+	"github.com/johnlindquist/gmkit/internal/store"
+	"github.com/rs/zerolog"
+	"go.mau.fi/mautrix-gmessages/pkg/libgm/gmproto"
+	"google.golang.org/protobuf/proto"
+	"path/filepath"
+	"testing"
+)
+
+func TestHistoryRetainsActionAndPreservesRicherExistingProtocol(t *testing.T) {
+	ctx := context.Background()
+	st, err := store.Open(ctx, filepath.Join(t.TempDir(), "gmcli.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer st.Close()
+	p := New(st, zerolog.Nop())
+	action := "part-a"
+	message := &gmproto.Message{MessageID: "m", ConversationID: "c", MessageInfo: []*gmproto.MessageInfo{{ActionMessageID: &action, Data: &gmproto.MessageInfo_MediaContent{MediaContent: &gmproto.MediaContent{MimeType: "image/png"}}}}}
+	p.ImportMessages(ctx, []*gmproto.Message{message})
+	var raw []byte
+	if err := st.DB().QueryRowContext(ctx, "SELECT raw_proto FROM messages WHERE message_id='m'").Scan(&raw); err != nil {
+		t.Fatal(err)
+	}
+	var evt gmproto.UpdateEvents
+	if err := proto.Unmarshal(raw, &evt); err != nil {
+		t.Fatal(err)
+	}
+	if evt.GetMessageEvent().GetData()[0].GetMessageInfo()[0].GetActionMessageID() != action {
+		t.Fatal("lost historical part action")
+	}
+	id, mt := "full", "image/png"
+	if err := st.UpsertMessage(ctx, store.Message{ID: "m", ConversationID: "c", MediaID: &id, MimeType: &mt, DecryptionKey: []byte("private-key"), RawProto: raw}); err != nil {
+		t.Fatal(err)
+	}
+	p.ImportMessages(ctx, []*gmproto.Message{message})
+	got, err := st.GetMessage(ctx, "m")
+	if err != nil || got.MediaID == nil || *got.MediaID != id || string(got.DecryptionKey) != "private-key" {
+		t.Fatal("history erased richer media")
+	}
+}
