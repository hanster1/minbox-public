+package gm
+
+import (
+	"context"
+	"fmt"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestMediaRequestTimeoutDedupCapacityAndRelease(t *testing.T) {
+	c := &Client{}
+	block := make(chan struct{})
+	var calls atomic.Int32
+	call := func() error { calls.Add(1); <-block; return nil }
+	for i := 0; i < 8; i++ {
+		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Millisecond)
+		err := c.requestFullMedia(ctx, "message", fmt.Sprint(i), call)
+		cancel()
+		if err == nil {
+			t.Fatal("unbounded request returned before timeout")
+		}
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Millisecond)
+	_ = c.requestFullMedia(ctx, "message", "0", call)
+	cancel()
+	if calls.Load() != 8 {
+		t.Fatal("timed out request was duplicated")
+	}
+	if err := c.requestFullMedia(context.Background(), "message", "overflow", call); err == nil {
+		t.Fatal("inflight capacity unbounded")
+	}
+	close(block)
+	deadline := time.Now().Add(time.Second)
+	for time.Now().Before(deadline) {
+		c.mu.RLock()
+		n := len(c.mediaRequests)
+		c.mu.RUnlock()
+		if n == 0 {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatal("completed request did not release capacity")
+}
