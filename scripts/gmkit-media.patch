diff --git c/cmd/minbox-refresh-session/main.go i/cmd/minbox-refresh-session/main.go
new file mode 100644
index 0000000..b9a6c51
--- /dev/null
+++ i/cmd/minbox-refresh-session/main.go
@@ -0,0 +1,236 @@
+// minbox-refresh-session creates a private refresh candidate for an existing
+// pairing. It never promotes credentials, pairs a device, or sends a message.
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"syscall"
+	"time"
+
+	"github.com/rs/zerolog"
+	"go.mau.fi/mautrix-gmessages/pkg/libgm"
+	"go.mau.fi/mautrix-gmessages/pkg/libgm/events"
+)
+
+var mutable = map[string]bool{"tachyon_token": true, "tachyon_expiry": true, "tachyon_ttl": true, "cookies": true}
+
+func mergeCandidate(original, baseline, refreshed []byte) ([]byte, error) {
+	var raw, before, after map[string]json.RawMessage
+	for _, p := range []struct {
+		data   []byte
+		target *map[string]json.RawMessage
+	}{{original, &raw}, {baseline, &before}, {refreshed, &after}} {
+		if err := json.Unmarshal(p.data, p.target); err != nil || *p.target == nil {
+			return nil, errors.New("invalid_session")
+		}
+	}
+	stable := func(m map[string]json.RawMessage) ([]byte, error) {
+		copy := map[string]json.RawMessage{}
+		for k, v := range m {
+			if !mutable[k] {
+				copy[k] = v
+			}
+		}
+		return json.Marshal(copy)
+	}
+	b, err := stable(before)
+	if err != nil {
+		return nil, err
+	}
+	a, err := stable(after)
+	if err != nil {
+		return nil, err
+	}
+	if !bytes.Equal(a, b) {
+		return nil, errors.New("binding_changed")
+	}
+	for key := range mutable {
+		if value, ok := after[key]; ok {
+			raw[key] = value
+		} else {
+			delete(raw, key)
+		}
+	}
+	return json.MarshalIndent(raw, "", "  ")
+}
+
+func safePath(path string) error {
+	absolute, err := filepath.Abs(path)
+	if err != nil {
+		return errors.New("invalid_path")
+	}
+	for p := absolute; ; p = filepath.Dir(p) {
+		if info, e := os.Lstat(p); e == nil && info.Mode()&os.ModeSymlink != 0 {
+			return errors.New("symlink_path")
+		}
+		if info, e := os.Stat(filepath.Join(p, ".git")); e == nil && !info.IsDir() {
+			return errors.New("git_path")
+		}
+		if _, e := os.Stat(filepath.Join(p, ".git", "HEAD")); e == nil {
+			return errors.New("git_path")
+		}
+		next := filepath.Dir(p)
+		if next == p {
+			break
+		}
+	}
+	return nil
+}
+
+func owned(info os.FileInfo) bool {
+	stat, ok := info.Sys().(*syscall.Stat_t)
+	return ok && stat.Uid == uint32(os.Getuid())
+}
+
+func candidatePath(path string) error {
+	if err := safePath(path); err != nil {
+		return err
+	}
+	if _, err := os.Lstat(path); !os.IsNotExist(err) {
+		return errors.New("candidate_exists")
+	}
+	parent := filepath.Dir(path)
+	if info, err := os.Stat(parent); err != nil || !info.IsDir() || info.Mode().Perm()&0077 != 0 || !owned(info) {
+		return errors.New("candidate_directory_not_private")
+	}
+	return nil
+}
+
+func writeCandidate(path string, data []byte) error {
+	if err := candidatePath(path); err != nil {
+		return err
+	}
+	parent := filepath.Dir(path)
+	f, err := os.CreateTemp(parent, ".refresh-candidate-")
+	if err != nil {
+		return errors.New("candidate_write_failed")
+	}
+	name := f.Name()
+	defer os.Remove(name)
+	defer f.Close()
+	if err := f.Chmod(0600); err != nil {
+		return errors.New("candidate_write_failed")
+	}
+	if _, err := f.Write(append(data, '\n')); err != nil {
+		return errors.New("candidate_write_failed")
+	}
+	if err := f.Sync(); err != nil {
+		return errors.New("candidate_write_failed")
+	}
+	if err := f.Close(); err != nil {
+		return errors.New("candidate_write_failed")
+	}
+	// Link publishes atomically without replacing any existing candidate.
+	if err := os.Link(name, path); err != nil {
+		return errors.New("candidate_write_failed")
+	}
+	return nil
+}
+
+func refresh(input, candidate string, timeout time.Duration) string {
+	if input == "" || candidate == "" || timeout <= 0 || timeout > 45*time.Second {
+		return "invalid_arguments"
+	}
+	if err := safePath(input); err != nil {
+		return "invalid_input_path"
+	}
+	if err := candidatePath(candidate); err != nil {
+		return "invalid_candidate_path"
+	}
+	info, err := os.Stat(input)
+	if err != nil || !info.Mode().IsRegular() || info.Mode().Perm()&0077 != 0 || !owned(info) {
+		return "input_not_private"
+	}
+	f, err := os.Open(input)
+	if err != nil {
+		return "input_unavailable"
+	}
+	original, err := io.ReadAll(io.LimitReader(f, 1024*1024+1))
+	f.Close()
+	if err != nil || len(original) > 1024*1024 {
+		return "invalid_session"
+	}
+	var auth libgm.AuthData
+	if err := json.Unmarshal(original, &auth); err != nil || auth.Browser == nil || auth.Mobile == nil || auth.RequestCrypto == nil || auth.RefreshKey == nil {
+		return "invalid_session"
+	}
+	baseline, err := json.Marshal(&auth)
+	if err != nil {
+		return "invalid_session"
+	}
+	auth.TachyonExpiry = time.Time{} // in memory only; failure never writes this.
+	client := libgm.NewClient(&auth, nil, zerolog.New(io.Discard))
+	defer client.Disconnect()
+	outcome := make(chan string, 1)
+	client.SetEventHandler(func(event any) {
+		if _, ok := event.(*events.AuthTokenRefreshed); !ok {
+			return
+		}
+		if len(auth.TachyonAuthToken) == 0 || !auth.TachyonExpiry.After(time.Now()) {
+			outcome <- "invalid_refresh"
+			return
+		}
+		auth.CookiesLock.RLock()
+		updated, e := json.Marshal(&auth)
+		auth.CookiesLock.RUnlock()
+		if e != nil {
+			outcome <- "invalid_refresh"
+			return
+		}
+		data, e := mergeCandidate(original, baseline, updated)
+		if e != nil {
+			outcome <- "binding_changed"
+			return
+		}
+		if e := writeCandidate(candidate, data); e != nil {
+			outcome <- "candidate_write_failed"
+			return
+		}
+		outcome <- "candidate_written"
+	})
+	connected := make(chan error, 1)
+	go func() { connected <- client.Connect() }()
+	timer := time.NewTimer(timeout)
+	defer timer.Stop()
+	select {
+	case status := <-outcome:
+		return status
+	case err := <-connected:
+		select {
+		case status := <-outcome:
+			return status
+		default:
+		}
+		if err != nil {
+			return "refresh_failed"
+		}
+		return "refresh_event_missing"
+	case <-timer.C:
+		return "refresh_timeout"
+	}
+}
+
+func main() {
+	flags := flag.NewFlagSet("minbox-refresh-session", flag.ContinueOnError)
+	flags.SetOutput(io.Discard)
+	input := flags.String("input", "", "existing private session file")
+	candidate := flags.String("candidate", "", "new candidate path in an existing private directory")
+	timeout := flags.Duration("timeout", 45*time.Second, "maximum runtime, at most 45 seconds")
+	if flags.Parse(os.Args[1:]) != nil {
+		fmt.Println(`{"status":"invalid_arguments"}`)
+		os.Exit(1)
+	}
+	status := refresh(*input, *candidate, *timeout)
+	encoded, _ := json.Marshal(map[string]string{"status": status})
+	fmt.Println(string(encoded))
+	if status != "candidate_written" {
+		os.Exit(1)
+	}
+}
