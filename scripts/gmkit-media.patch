diff --git c/internal/cmd/media_daemon_test.go i/internal/cmd/media_daemon_test.go
new file mode 100644
index 0000000..696bc11
--- /dev/null
+++ i/internal/cmd/media_daemon_test.go
@@ -0,0 +1,31 @@
+package cmd_test
+
+import (
+	"github.com/johnlindquist/gmkit/internal/cmd"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestMediaDownloadRequiresExistingDaemonWithoutAutoStart(t *testing.T) {
+	directory, err := os.MkdirTemp("", "gmmedia-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(directory)
+	root := cmd.Root()
+	root.SetArgs([]string{"--store", directory, "--read-only=true", "--json", "media", "download", "--message", "fixture"})
+	started := time.Now()
+	err = root.Execute()
+	if err == nil || !strings.Contains(err.Error(), "connect to gmcli daemon") {
+		t.Fatalf("must fail directly at existing daemon socket: %v", err)
+	}
+	if time.Since(started) > 3*time.Second {
+		t.Fatal("missing collector failure exceeded connection timeout")
+	}
+	if _, err := os.Stat(filepath.Join(directory, "gmcli.db")); !os.IsNotExist(err) {
+		t.Fatal("missing-daemon media call opened a collector store")
+	}
+}
diff --git c/internal/cmd/phone_spam.go i/internal/cmd/phone_spam.go
new file mode 100644
index 0000000..3154094
--- /dev/null
+++ i/internal/cmd/phone_spam.go
@@ -0,0 +1,111 @@
+package cmd
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"github.com/johnlindquist/gmkit/internal/store"
+	gmsync "github.com/johnlindquist/gmkit/internal/sync"
+	"github.com/rs/zerolog"
+	"go.mau.fi/mautrix-gmessages/pkg/libgm/gmproto"
+)
+
+const phoneSpamLimit = 500
+const phoneSpamInterval = 5 * time.Minute
+const phoneSpamTimeout = 30 * time.Second
+
+type phoneSpamLister interface {
+	ListConversations(int, gmproto.ListConversationsRequest_Folder) (*gmproto.ListConversationsResponse, error)
+}
+type phoneSpamResult struct {
+	response *gmproto.ListConversationsResponse
+	err      error
+}
+
+// phoneSpamScanner uses the already-connected client and reads metadata only.
+// libgm has no cancellable list or exported cursor API. At most one request is
+// outstanding; a timed-out request is retained for the next scan, not retried
+// concurrently. Scan never infers spam, deletion or unblocking from absence.
+type phoneSpamScanner struct {
+	client   phoneSpamLister
+	store    *store.Store
+	logger   zerolog.Logger
+	inFlight <-chan phoneSpamResult
+	timeout  time.Duration
+}
+
+func (s *phoneSpamScanner) scan(ctx context.Context) {
+	if s.inFlight == nil {
+		result := make(chan phoneSpamResult, 1)
+		s.inFlight = result
+		go func() {
+			response, err := s.client.ListConversations(phoneSpamLimit, gmproto.ListConversationsRequest_SPAM_BLOCKED)
+			result <- phoneSpamResult{response, err}
+		}()
+	}
+	wait := s.timeout
+	if wait <= 0 {
+		wait = phoneSpamTimeout
+	}
+	bounded, cancel := context.WithTimeout(ctx, wait)
+	defer cancel()
+	var result phoneSpamResult
+	select {
+	case result = <-s.inFlight:
+		s.inFlight = nil
+	case <-bounded.Done():
+		s.record(ctx, "pending", 0, false, "metadata request still pending; no concurrent retry")
+		return
+	}
+	if result.err != nil || result.response == nil {
+		s.record(ctx, "failed", 0, false, "metadata request failed")
+		return
+	}
+	conversations := result.response.GetConversations()
+	cursor := result.response.GetCursor() != nil || len(result.response.GetCursorBytes()) > 0
+	coverage := "snapshot"
+	if len(conversations) >= phoneSpamLimit || cursor {
+		coverage = "capped"
+	}
+	// Snapshot describes this one response, not a verified complete account.
+	// Full cursor traversal requires a change to the locked SDK dependency.
+	scanRows := conversations
+	if len(scanRows) > phoneSpamLimit {
+		scanRows = scanRows[:phoneSpamLimit]
+	}
+	for _, conversation := range scanRows {
+		if conversation == nil {
+			continue
+		}
+		row, ok := gmsync.ConversationRow(conversation, "gm")
+		if !ok {
+			continue
+		}
+		if err := s.store.UpsertConversation(ctx, row); err != nil {
+			s.record(ctx, "failed", len(conversations), cursor, "metadata persistence failed")
+			return
+		}
+	}
+	s.record(ctx, coverage, len(conversations), cursor, "")
+}
+
+func (s *phoneSpamScanner) record(ctx context.Context, coverage string, count int, cursor bool, failure string) {
+	now := time.Now().UnixMilli()
+	success := int64(0)
+	if coverage == "snapshot" || coverage == "capped" {
+		success = now
+	}
+	_, err := s.store.DB().ExecContext(ctx, `UPDATE phone_spam_scan_state SET
+ attempted_at=?, succeeded_at=CASE WHEN ? > 0 THEN ? ELSE succeeded_at END,
+ coverage=?, conversation_limit=?, returned_count=?, has_cursor=?, error=? WHERE id=1`,
+		now, success, success, coverage, phoneSpamLimit, count, cursor, failure)
+	if err != nil {
+		s.logger.Warn().Err(err).Msg("Phone spam coverage persistence failed")
+	}
+	if failure != "" || coverage == "capped" {
+		s.logger.Warn().Str("coverage", coverage).Int("limit", phoneSpamLimit).Int("returned", count).Bool("has_cursor", cursor).Msg(fmt.Sprintf("Phone spam metadata reconciliation: %s", failure))
+	} else {
+		s.logger.Info().Str("coverage", coverage).Int("returned", count).Msg("Phone spam metadata reconciled; absence is not evidence")
+	}
+}
diff --git c/internal/cmd/phone_spam_test.go i/internal/cmd/phone_spam_test.go
new file mode 100644
index 0000000..0995b91
--- /dev/null
+++ i/internal/cmd/phone_spam_test.go
@@ -0,0 +1,114 @@
+package cmd
+
+import (
+	"context"
+	"errors"
+	"path/filepath"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/johnlindquist/gmkit/internal/store"
+	"github.com/rs/zerolog"
+	"go.mau.fi/mautrix-gmessages/pkg/libgm/gmproto"
+)
+
+type spamListFixture struct {
+	response    *gmproto.ListConversationsResponse
+	err         error
+	release     chan struct{}
+	calls       atomic.Int32
+	wrongFolder atomic.Bool
+}
+
+func (f *spamListFixture) ListConversations(count int, folder gmproto.ListConversationsRequest_Folder) (*gmproto.ListConversationsResponse, error) {
+	f.calls.Add(1)
+	if count != 500 || folder != gmproto.ListConversationsRequest_SPAM_BLOCKED {
+		f.wrongFolder.Store(true)
+	}
+	if f.release != nil {
+		<-f.release
+	}
+	return f.response, f.err
+}
+
+func TestPhoneSpamMetadataOnlyReconciliationReportsCoverage(t *testing.T) {
+	ctx := context.Background()
+	for _, test := range []struct {
+		name     string
+		response *gmproto.ListConversationsResponse
+		err      error
+		coverage string
+	}{
+		{"positive", &gmproto.ListConversationsResponse{Conversations: []*gmproto.Conversation{{ConversationID: "spam", Status: 5}, {ConversationID: "blocked", Status: 6}}}, nil, "snapshot"},
+		{"empty", &gmproto.ListConversationsResponse{}, nil, "snapshot"},
+		{"cursor", &gmproto.ListConversationsResponse{CursorBytes: []byte{1}}, nil, "capped"},
+		{"limit", &gmproto.ListConversationsResponse{Conversations: make([]*gmproto.Conversation, 500)}, nil, "capped"},
+		{"failure", nil, errors.New("fixture failure"), "failed"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			st, err := store.Open(ctx, filepath.Join(t.TempDir(), "archive.db"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer st.Close()
+			// Missing entries must never clear past observations.
+			if err := st.UpsertConversation(ctx, store.Conversation{ID: "existing", PhoneStatus: 5}); err != nil {
+				t.Fatal(err)
+			}
+			fixture := &spamListFixture{response: test.response, err: test.err}
+			scanner := &phoneSpamScanner{client: fixture, store: st, logger: zerolog.Nop()}
+			scanner.scan(ctx)
+			var coverage string
+			if err := st.DB().QueryRowContext(ctx, "SELECT coverage FROM phone_spam_scan_state").Scan(&coverage); err != nil || coverage != test.coverage {
+				t.Fatalf("coverage %s: %v", coverage, err)
+			}
+			var count int
+			if err := st.DB().QueryRowContext(ctx, "SELECT COUNT(*) FROM phone_spam_conversations WHERE conversation_id='existing'").Scan(&count); err != nil || count != 1 {
+				t.Fatal("scan cleared observation")
+			}
+
+			if fixture.wrongFolder.Load() {
+				t.Fatal("queried incorrect folder")
+			}
+			if test.name == "positive" {
+				if err := st.DB().QueryRowContext(ctx, "SELECT COUNT(*) FROM phone_spam_conversations").Scan(&count); err != nil || count != 3 {
+					t.Fatalf("positive metadata missing: %d %v", count, err)
+				}
+			}
+			if err := st.DB().QueryRowContext(ctx, "SELECT COUNT(*) FROM messages").Scan(&count); err != nil || count != 0 {
+				t.Fatal("metadata scan imported message history")
+			}
+		})
+	}
+}
+
+func TestPhoneSpamPendingRequestIsBoundedWithoutConcurrentRetry(t *testing.T) {
+	ctx := context.Background()
+	st, err := store.Open(ctx, filepath.Join(t.TempDir(), "archive.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer st.Close()
+	release := make(chan struct{})
+	fixture := &spamListFixture{response: &gmproto.ListConversationsResponse{}, release: release}
+	scanner := &phoneSpamScanner{client: fixture, store: st, logger: zerolog.Nop(), timeout: 10 * time.Millisecond}
+	scanner.scan(ctx)
+	scanner.scan(ctx)
+	if fixture.calls.Load() != 1 {
+		t.Fatal("pending request retried concurrently")
+	}
+	var coverage string
+	if err := st.DB().QueryRowContext(ctx, "SELECT coverage FROM phone_spam_scan_state").Scan(&coverage); err != nil || coverage != "pending" {
+		t.Fatalf("pending coverage %s %v", coverage, err)
+	}
+	close(release)
+	scanner.timeout = time.Second
+	scanner.scan(ctx)
+	if fixture.calls.Load() != 1 {
+		t.Fatal("completed pending response not reused")
+	}
+	if err := st.DB().QueryRowContext(ctx, "SELECT coverage FROM phone_spam_scan_state").Scan(&coverage); err != nil || coverage != "snapshot" {
+		t.Fatalf("recovered coverage %s %v", coverage, err)
+	}
+}
