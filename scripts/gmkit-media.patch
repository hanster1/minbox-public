new file mode 100644
index 0000000..ea29fd8
--- /dev/null
+++ i/internal/media/media.go
@@ -0,0 +1,182 @@
+// Package media retrieves full attachment bytes without exposing protocol keys.
+package media
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/johnlindquist/gmkit/internal/gm"
+	"github.com/johnlindquist/gmkit/internal/store"
+	"go.mau.fi/mautrix-gmessages/pkg/libgm/gmproto"
+	"google.golang.org/protobuf/proto"
+)
+
+type Attachment struct {
+	AttachmentID string `json:"attachment_id"`
+	MediaID      string `json:"media_id,omitempty"`
+	MimeType     string `json:"mime_type"`
+	Path         string `json:"path,omitempty"`
+	Bytes        int    `json:"bytes,omitempty"`
+	CaptureKind  string `json:"capture_kind,omitempty"`
+	Status       string `json:"capture_status"`
+	key          []byte
+	action       string
+	declaredSize int64
+}
+
+type Result struct {
+	MessageID   string       `json:"message_id"`
+	Path        string       `json:"path,omitempty"`
+	Bytes       int          `json:"bytes,omitempty"`
+	MimeType    string       `json:"mime_type,omitempty"`
+	Attachments []Attachment `json:"attachments"`
+}
+
+// Parts decodes ONLY the exact message and never substitutes a thumbnail key.
+func Parts(raw []byte, messageID string) ([]Attachment, error) {
+	var evt gmproto.UpdateEvents
+	if err := proto.Unmarshal(raw, &evt); err != nil {
+		return nil, fmt.Errorf("invalid stored media protocol")
+	}
+	var out []Attachment
+	for _, m := range evt.GetMessageEvent().GetData() {
+		if m.GetMessageID() != messageID {
+			continue
+		}
+		for i, info := range m.GetMessageInfo() {
+			mc := info.GetMediaContent()
+			if mc == nil {
+				continue
+			}
+			id := info.GetActionMessageID()
+			if id == "" {
+				id = fmt.Sprintf("part-%d", i)
+			}
+			out = append(out, Attachment{AttachmentID: id, MediaID: mc.GetMediaID(), MimeType: mc.GetMimeType(), key: mc.GetDecryptionKey(), action: info.GetActionMessageID(), declaredSize: mc.GetSize(), Status: "unavailable"})
+		}
+	}
+	return out, nil
+}
+
+func readParts(ctx context.Context, st *store.Store, id string) ([]Attachment, error) {
+	var raw []byte
+	if err := st.DB().QueryRowContext(ctx, "SELECT raw_proto FROM messages WHERE message_id=?", id).Scan(&raw); err != nil {
+		return nil, err
+	}
+	if len(raw) == 0 {
+		m, err := st.GetMessage(ctx, id)
+		if err != nil {
+			return nil, err
+		}
+		if m.MediaID == nil {
+			return nil, nil
+		}
+		mt := ""
+		if m.MimeType != nil {
+			mt = *m.MimeType
+		}
+		return []Attachment{{AttachmentID: "part-0", MediaID: *m.MediaID, MimeType: mt, key: m.DecryptionKey, Status: "unavailable"}}, nil
+	}
+	return Parts(raw, id)
+}
+
+const maxMediaBytes = 20 * 1024 * 1024
+
+func eligible(a Attachment) bool {
+	return strings.HasPrefix(a.MimeType, "image/") && a.declaredSize >= 0 && a.declaredSize <= maxMediaBytes
+}
+func full(a Attachment) bool { return eligible(a) && a.MediaID != "" && len(a.key) > 0 }
+
+// Download asks the existing daemon connection for missing full-image metadata.
+// The refresh window is shared across every part and never holds a DB transaction.
+func Download(ctx context.Context, c *gm.Client, st *store.Store, id, directory string) (Result, error) {
+	result := Result{MessageID: id}
+	parts, err := readParts(ctx, st, id)
+	if err != nil {
+		return result, err
+	}
+	if len(parts) == 0 {
+		return result, fmt.Errorf("message has no attached media")
+	}
+	if len(parts) > 32 {
+		return result, fmt.Errorf("message exceeds media part limit")
+	}
+	refreshCtx, cancel := context.WithTimeout(ctx, 12*time.Second)
+	defer cancel()
+	pending := false
+	for _, a := range parts {
+		if eligible(a) && !full(a) && strings.HasPrefix(a.MimeType, "image/") && a.action != "" {
+			pending = true
+			go func(a Attachment) { _ = c.RequestFullMedia(refreshCtx, id, a.action) }(a)
+		}
+	}
+	ticker := time.NewTicker(200 * time.Millisecond)
+	defer ticker.Stop()
+wait:
+	for pending {
+		select {
+		case <-refreshCtx.Done():
+			break wait
+		case <-ticker.C:
+			fresh, e := readParts(ctx, st, id)
+			if e != nil {
+				return result, e
+			}
+			pending = false
+			for i := range parts {
+				if !full(parts[i]) {
+					for _, a := range fresh {
+						if a.AttachmentID == parts[i].AttachmentID && full(a) {
+							parts[i] = a
+							break
+						}
+					}
+				}
+				if eligible(parts[i]) && !full(parts[i]) && strings.HasPrefix(parts[i].MimeType, "image/") && parts[i].action != "" {
+					pending = true
+				}
+			}
+		}
+	}
+	if err := ctx.Err(); err != nil {
+		return result, err
+	}
+	totalBytes := 0
+	for i := range parts {
+		if ctx.Err() != nil {
+			break
+		}
+		a := &parts[i]
+		if !full(*a) {
+			continue
+		}
+		data, e := c.DownloadMediaContext(ctx, a.MediaID, a.key)
+		if e != nil || len(data) == 0 || len(data) > maxMediaBytes || totalBytes+len(data) > 80*1024*1024 {
+			continue
+		}
+		totalBytes += len(data)
+		sum := sha256.Sum256([]byte(id + "\x00" + a.AttachmentID))
+		path := filepath.Join(directory, hex.EncodeToString(sum[:])+".media")
+		if info, e := os.Lstat(path); e == nil && (!info.Mode().IsRegular() || info.Mode()&os.ModeSymlink != 0) {
+			return result, fmt.Errorf("invalid media output path")
+		}
+		if e := os.WriteFile(path, data, 0600); e != nil {
+			return result, e
+		}
+		if e := os.Chmod(path, 0600); e != nil {
+			return result, e
+		}
+		a.Path, a.Bytes, a.Status, a.CaptureKind = path, len(data), "captured", "full"
+		if result.Path == "" {
+			result.Path, result.Bytes, result.MimeType = path, len(data), a.MimeType
+		}
+	}
+	result.Attachments = parts
+	return result, nil
+}
