+func TestStrippedHistoryPreservesFullMediaWithoutMixingChangedKeys(t *testing.T) {
+	st := openTempStore(t)
+	ctx := context.Background()
+	id, mt := "full", "image/png"
+	original := store.Message{ID: "m", ConversationID: "c", MediaID: &id, MimeType: &mt, DecryptionKey: []byte("secret"), RawProto: []byte("protocol")}
+	if err := st.UpsertMessage(ctx, original); err != nil {
+		t.Fatal(err)
+	}
+	if err := st.UpsertMessage(ctx, store.Message{ID: "m", ConversationID: "c"}); err != nil {
+		t.Fatal(err)
+	}
+	m, err := st.GetMessage(ctx, "m")
+	if err != nil || m.MediaID == nil || *m.MediaID != "full" || string(m.DecryptionKey) != "secret" {
+		t.Fatal("stripped history lost media")
+	}
+	var raw []byte
+	if err := st.DB().QueryRowContext(ctx, "SELECT raw_proto FROM messages WHERE message_id='m'").Scan(&raw); err != nil || string(raw) != "protocol" {
+		t.Fatal("lost raw protocol")
+	}
+	changed := "new-media"
+	if err := st.UpsertMessage(ctx, store.Message{ID: "m", ConversationID: "c", MediaID: &changed}); err != nil {
+		t.Fatal(err)
+	}
+	m, _ = st.GetMessage(ctx, "m")
+	if *m.MediaID != "new-media" || len(m.DecryptionKey) != 0 {
+		t.Fatal("mixed changed media identity with old key")
+	}
+	if err := st.DB().QueryRowContext(ctx, "SELECT raw_proto FROM messages WHERE message_id='m'").Scan(&raw); err != nil || len(raw) != 0 {
+		t.Fatal("retained old protocol for changed media identity")
+	}
+}
