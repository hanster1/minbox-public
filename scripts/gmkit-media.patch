@@ -0,0 +1,47 @@
+package main
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestCandidatePreservesBindingsUnknownFieldsAndAllowsOnlyRefreshFields(t *testing.T) {
+	original := []byte(`{"browser":{"id":"paired"},"session_id":"stable","unknown_future":{"keep":true},"tachyon_token":"old","cookies":{"c":"old"}}`)
+	baseline := []byte(`{"browser":{"id":"paired"},"session_id":"stable","tachyon_token":"old","cookies":{"c":"old"}}`)
+	after := []byte(`{"browser":{"id":"paired"},"session_id":"stable","tachyon_token":"new","tachyon_ttl":123,"cookies":{"c":"new"}}`)
+	candidate, err := mergeCandidate(original, baseline, after)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var value map[string]any
+	json.Unmarshal(candidate, &value)
+	if value["unknown_future"] == nil || value["tachyon_token"] != "new" || value["session_id"] != "stable" {
+		t.Fatal("lost original data or refresh")
+	}
+	for _, changed := range []string{`{"browser":{"id":"other"},"session_id":"stable"}`, `{"browser":{"id":"paired"},"session_id":"other"}`} {
+		if _, err := mergeCandidate(original, baseline, []byte(changed)); err == nil {
+			t.Fatal("changed pairing accepted")
+		}
+	}
+}
+func TestCandidateWritePrivateAtomicNeverReplaces(t *testing.T) {
+	parent := t.TempDir()
+	os.Chmod(parent, 0700)
+	path := filepath.Join(parent, "candidate.json")
+	if err := writeCandidate(path, []byte(`{"private":"fixture"}`)); err != nil {
+		t.Fatal(err)
+	}
+	if info, _ := os.Stat(path); info.Mode().Perm() != 0600 {
+		t.Fatal("candidate mode not private")
+	}
+	if err := writeCandidate(path, []byte("replacement")); err == nil {
+		t.Fatal("overwrote existing candidate")
+	}
+	link := filepath.Join(parent, "link.json")
+	os.Symlink(path, link)
+	if err := writeCandidate(link, []byte("replacement")); err == nil {
+		t.Fatal("followed symlink")
+	}
+}
