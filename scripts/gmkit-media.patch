+// mediaRequest remains registered until libgm actually returns: the upstream
+// request has no cancellation API. This bounds timed-out calls to eight per client.
+type mediaRequest struct {
+	done chan struct{}
+	err  error
+}
+
+func (c *Client) RequestFullMedia(ctx context.Context, messageID, actionID string) error {
+	return c.requestFullMedia(ctx, messageID, actionID, func() error { _, err := c.libgm.GetFullSizeImage(messageID, actionID); return err })
+}
+
+func (c *Client) requestFullMedia(ctx context.Context, messageID, actionID string, call func() error) error {
+	if messageID == "" || actionID == "" {
+		return fmt.Errorf("media action identity required")
+	}
+	key := messageID + "\x00" + actionID
+	c.mu.Lock()
+	if c.mediaRequests == nil {
+		c.mediaRequests = make(map[string]*mediaRequest)
+	}
+	request := c.mediaRequests[key]
+	if request == nil {
+		if len(c.mediaRequests) >= 8 {
+			c.mu.Unlock()
+			return fmt.Errorf("media request capacity reached")
+		}
+		request = &mediaRequest{done: make(chan struct{})}
+		c.mediaRequests[key] = request
+		go func() {
+			err := call()
+			c.mu.Lock()
+			request.err = err
+			delete(c.mediaRequests, key)
+			close(request.done)
+			c.mu.Unlock()
+		}()
+	}
+	c.mu.Unlock()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-request.done:
+		return request.err
+	}
+}
+
+type mediaDownload struct {
+	done chan struct{}
+	data []byte
+	err  error
+}
+
+// DownloadMediaContext bounds the caller even though libgm HTTP has no context.
+// Inflight dedup/capacity prevents retries from accumulating hung downloads.
+func (c *Client) DownloadMediaContext(ctx context.Context, id string, key []byte) ([]byte, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	identity := sha256.Sum256(append(append([]byte(id), 0), key...))
+	c.mu.Lock()
+	if c.mediaDownloads == nil {
+		c.mediaDownloads = make(map[[32]byte]*mediaDownload)
+	}
+	request := c.mediaDownloads[identity]
+	if request == nil {
+		if len(c.mediaDownloads) >= 8 {
+			c.mu.Unlock()
+			return nil, fmt.Errorf("media download capacity reached")
+		}
+		request = &mediaDownload{done: make(chan struct{})}
+		c.mediaDownloads[identity] = request
+		go func() {
+			data, err := c.DownloadMedia(id, key)
+			c.mu.Lock()
+			request.data, request.err = data, err
+			delete(c.mediaDownloads, identity)
+			close(request.done)
+			c.mu.Unlock()
+		}()
+	}
+	c.mu.Unlock()
+	select {
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	case <-request.done:
+		return request.data, request.err
+	}
+}
+
