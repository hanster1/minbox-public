@@ -0,0 +1,31 @@
+package cmd_test
+
+import (
+	"github.com/johnlindquist/gmkit/internal/cmd"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestMediaDownloadRequiresExistingDaemonWithoutAutoStart(t *testing.T) {
+	directory, err := os.MkdirTemp("", "gmmedia-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(directory)
+	root := cmd.Root()
+	root.SetArgs([]string{"--store", directory, "--read-only=true", "--json", "media", "download", "--message", "fixture"})
+	started := time.Now()
+	err = root.Execute()
+	if err == nil || !strings.Contains(err.Error(), "connect to gmcli daemon") {
+		t.Fatalf("must fail directly at existing daemon socket: %v", err)
+	}
+	if time.Since(started) > 3*time.Second {
+		t.Fatal("missing collector failure exceeded connection timeout")
+	}
+	if _, err := os.Stat(filepath.Join(directory, "gmcli.db")); !os.IsNotExist(err) {
+		t.Fatal("missing-daemon media call opened a collector store")
+	}
+}
