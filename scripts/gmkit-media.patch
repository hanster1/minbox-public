@@ -0,0 +1,74 @@
+package sync
+
+import (
+	"context"
+	"path/filepath"
+	"testing"
+
+	"github.com/johnlindquist/gmkit/internal/store"
+	"github.com/rs/zerolog"
+	"go.mau.fi/mautrix-gmessages/pkg/libgm/gmproto"
+)
+
+func TestPhoneSpamStatusDistinguishesArchiveDeleteUnknownAndStaysSticky(t *testing.T) {
+	ctx := context.Background()
+	st, err := store.Open(ctx, filepath.Join(t.TempDir(), "archive.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer st.Close()
+	pump := New(st, zerolog.Nop())
+	for _, status := range []gmproto.ConversationStatus{0, 1, 2, 3, 4, 5, 6, 7, 99} {
+		id := status.String()
+		pump.Handle(&gmproto.Conversation{ConversationID: id, Status: status})
+		row, err := st.GetConversation(ctx, id)
+		if err != nil || row.PhoneStatus != int64(status) {
+			t.Fatalf("status %d lost: %+v %v", status, row, err)
+		}
+		if row.Archived != (status == 2 || status == 4) {
+			t.Fatalf("incorrect archive status %d", status)
+		}
+		var count int
+		if err := st.DB().QueryRowContext(ctx, "SELECT COUNT(*) FROM phone_spam_conversations WHERE conversation_id=?", id).Scan(&count); err != nil {
+			t.Fatal(err)
+		}
+		want := 0
+		if status == 5 || status == 6 {
+			want = 1
+		}
+		if count != want {
+			t.Fatalf("status %d produced %d observations, want %d", status, count, want)
+		}
+	}
+	for _, initial := range []gmproto.ConversationStatus{5, 6} {
+		id := initial.String()
+		pump.Handle(&gmproto.Conversation{ConversationID: id, Status: 1})
+		var positive int64
+		var observed int64
+		if err := st.DB().QueryRowContext(ctx, "SELECT status, observed_at FROM phone_spam_conversations WHERE conversation_id=?", id).Scan(&positive, &observed); err != nil {
+			t.Fatal(err)
+		}
+		if positive != int64(initial) || observed <= 0 {
+			t.Fatal("ACTIVE cleared positive evidence")
+		}
+	}
+	// The durable ledger survives reopening the collector.
+	path := filepath.Join(t.TempDir(), "reopen.db")
+	other, err := store.Open(ctx, path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := other.UpsertConversation(ctx, store.Conversation{ID: "retained", PhoneStatus: 5}); err != nil {
+		t.Fatal(err)
+	}
+	other.Close()
+	other, err = store.Open(ctx, path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer other.Close()
+	var count int
+	if err := other.DB().QueryRowContext(ctx, "SELECT COUNT(*) FROM phone_spam_conversations WHERE conversation_id='retained'").Scan(&count); err != nil || count != 1 {
+		t.Fatalf("durability: %d %v", count, err)
+	}
+}
