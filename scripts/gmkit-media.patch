@@ -0,0 +1,45 @@
+package store
+
+import (
+	"context"
+	"path/filepath"
+	"testing"
+)
+
+func TestPhoneSpamMigrationPreservesExistingArchive(t *testing.T) {
+	ctx := context.Background()
+	path := filepath.Join(t.TempDir(), "archive.db")
+	st, err := Open(ctx, path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := st.UpsertConversation(ctx, Conversation{ID: "prior", Name: "Existing archive"}); err != nil {
+		t.Fatal(err)
+	}
+	// Restore the actual v3 schema and reopen as an existing installation.
+	for _, sql := range []string{"DROP TABLE phone_spam_conversations", "DROP TABLE phone_spam_scan_state", "ALTER TABLE conversations DROP COLUMN phone_status", "DELETE FROM schema_version WHERE version=4"} {
+		if _, err := st.DB().ExecContext(ctx, sql); err != nil {
+			t.Fatal(err)
+		}
+	}
+	st.Close()
+	st, err = Open(ctx, path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer st.Close()
+	row, err := st.GetConversation(ctx, "prior")
+	if err != nil || row.Name != "Existing archive" || row.PhoneStatus != 0 {
+		t.Fatalf("migration changed prior row: %+v %v", row, err)
+	}
+	if err := st.UpsertConversation(ctx, Conversation{ID: "prior", Name: row.Name, PhoneStatus: 5}); err != nil {
+		t.Fatal(err)
+	}
+	if err := st.UpsertConversation(ctx, Conversation{ID: "prior", Name: row.Name, PhoneStatus: 3}); err != nil {
+		t.Fatal(err)
+	}
+	var status int64
+	if err := st.DB().QueryRowContext(ctx, "SELECT status FROM phone_spam_conversations WHERE conversation_id='prior'").Scan(&status); err != nil || status != 5 {
+		t.Fatalf("deletion cleared observation: %d %v", status, err)
+	}
+}
