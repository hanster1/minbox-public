+package media
+
+import (
+	"encoding/json"
+	"go.mau.fi/mautrix-gmessages/pkg/libgm/gmproto"
+	"google.golang.org/protobuf/proto"
+	"strings"
+	"testing"
+)
+
+func part(action, id string, key []byte) *gmproto.MessageInfo {
+	return &gmproto.MessageInfo{ActionMessageID: &action, Data: &gmproto.MessageInfo_MediaContent{MediaContent: &gmproto.MediaContent{MediaID: id, DecryptionKey: key, MimeType: "image/png", ThumbnailMediaID: "preview", ThumbnailDecryptionKey: []byte("secret-preview")}}}
+}
+func TestPartsExactMessageAllAttachmentsNoPreviewOrKeysInJSON(t *testing.T) {
+	raw, err := proto.Marshal(&gmproto.UpdateEvents{Event: &gmproto.UpdateEvents_MessageEvent{MessageEvent: &gmproto.MessageEvent{Data: []*gmproto.Message{
+		{MessageID: "other", MessageInfo: []*gmproto.MessageInfo{part("wrong", "wrong", []byte("wrong"))}},
+		{MessageID: "wanted", MessageInfo: []*gmproto.MessageInfo{part("a", "", nil), part("b", "full", []byte("secret-full"))}},
+	}}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	parts, err := Parts(raw, "wanted")
+	if err != nil || len(parts) != 2 {
+		t.Fatalf("parts=%d err=%v", len(parts), err)
+	}
+	if parts[0].AttachmentID != "a" || full(parts[0]) || !full(parts[1]) {
+		t.Fatal("wrong identity or thumbnail substituted")
+	}
+	data, _ := json.Marshal(parts)
+	if strings.Contains(string(data), "secret") || strings.Contains(string(data), "preview") {
+		t.Fatal("private protocol fields exposed")
+	}
+	absent, err := Parts(raw, "missing")
+	if err != nil || len(absent) != 0 {
+		t.Fatal("selected another message")
+	}
+}
+
+func TestDeclaredSizeAndNonImageBoundaries(t *testing.T) {
+	if eligible(Attachment{MimeType: "video/mp4"}) {
+		t.Fatal("video download allowed")
+	}
+	if eligible(Attachment{MimeType: "image/png", declaredSize: maxMediaBytes + 1}) {
+		t.Fatal("oversized declared image allowed")
+	}
+	if !eligible(Attachment{MimeType: "image/png", declaredSize: maxMediaBytes}) {
+		t.Fatal("bounded image rejected")
+	}
+}
